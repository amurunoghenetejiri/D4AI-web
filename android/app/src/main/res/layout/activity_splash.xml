<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/splashRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/d4ai_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Glow rings + logo -->
        <FrameLayout
            android:layout_width="180dp"
            android:layout_height="180dp"
            android:layout_gravity="center">

            <View
                android:id="@+id/ringOuter"
                android:layout_width="180dp"
                android:layout_height="180dp"
                android:layout_gravity="center"
                android:background="@drawable/splash_ring_outer" />

            <View
                android:id="@+id/ringMid"
                android:layout_width="140dp"
                android:layout_height="140dp"
                android:layout_gravity="center"
                android:background="@drawable/splash_ring_mid" />

            <ImageView
                android:id="@+id/logo"
                android:layout_width="110dp"
                android:layout_height="110dp"
                android:layout_gravity="center"
                android:contentDescription="@string/app_name"
                android:src="@drawable/d4ai_logo"
                android:scaleType="fitCenter" />
        </FrameLayout>

        <TextView
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:letterSpacing="0.18"
            android:text="@string/d4ai_title"
            android:textColor="@color/d4ai_text"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/brand"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:letterSpacing="0.35"
            android:text="@string/d4ai_brand"
            android:textColor="@color/d4ai_muted"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/motto"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/d4ai_motto"
            android:textColor="@color/d4ai_muted"
            android:textSize="12sp" />

        <ProgressBar
            android:id="@+id/progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="120dp"
            android:layout_height="3dp"
            android:layout_marginTop="28dp"
            android:indeterminate="false"
            android:max="100"
            android:progress="15"
            android:progressDrawable="@drawable/splash_progress" />
    </LinearLayout>
</FrameLayout>
