<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- AppCompatActivity requires an AppCompat theme; the old platform theme caused
         an IllegalStateException during Activity startup on affected devices. -->
    <style name="AppTheme" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:statusBarColor">@color/d4ai_bg</item>
        <item name="android:navigationBarColor">@color/d4ai_bg</item>
        <item name="android:windowBackground">@color/d4ai_bg</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="colorPrimary">@color/d4ai_cyan</item>
        <item name="colorPrimaryDark">@color/d4ai_bg</item>
        <item name="colorAccent">@color/d4ai_cyan</item>
        <item name="android:textColorPrimary">@color/d4ai_text</item>
    </style>
</resources>
